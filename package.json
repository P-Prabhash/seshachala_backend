{
  "name": "seshachala-fee-management",
  "version": "1.0.0",
  "description": "Seshachala Student Fee Management - Node.js + Express + MySQL Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node database/migrate.js",
    "migrate:status": "node database/migrate.js --status",
    "seed": "node database/seed.js",
    "test": "jest --detectOpenHandles --runInBand",
    "test:integration": "jest tests/integration --detectOpenHandles --runInBand"
  },
  "keywords": [
    "nodejs",
    "express",
    "mysql",
    "student-fee-management"
  ],
  "author": "Seshachala",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-flash": "^0.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "nunjucks": "^3.2.4",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "optionalDependencies": {
    "sqlite3": "^6.0.1"
  }
